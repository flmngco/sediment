#!/usr/bin/env bash
# Runs every configuration and compares the outcome with its expectation: "pass", or
# the name of the invariant that must be violated. A third column names the spec
# (S3Fence by default). An argument runs only the configs whose name matches it:
#   formal/bin/check          # all
#   formal/bin/check '^Kr|Kr' # the KeyRotation ones
set -uo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
cd "$here/tla"
only="${1:-}"
status=0
while read -r cfg expect spec; do
  [ -z "$cfg" ] && continue
  [ -n "$only" ] && ! grep -qE "$only" <<<"$cfg" && continue
  out="$("$here/bin/tlc" "${spec:-S3Fence}.tla" -config "$cfg.cfg" 2>&1)"
  if grep -qE "(Invariant|Action property) [A-Za-z]* is violated" <<<"$out"; then
    got="$(grep -oE "(Invariant|Action property) [A-Za-z]* is violated" <<<"$out" | head -1 | awk '{print $(NF-2)}')"
  elif grep -qE "Temporal property [A-Za-z]* was violated" <<<"$out"; then
    got="$(grep -oE "Temporal property [A-Za-z]* was violated" <<<"$out" | head -1 | awk '{print $3}')"
  elif grep -q "_POSSIBLE predicate [A-Za-z]* .*was never witnessed" <<<"$out"; then
    got="unwitnessed:$(grep -o "_POSSIBLE predicate [A-Za-z]*" <<<"$out" | head -1 | awk '{print $3}')"
  elif grep -q "No error has been found" <<<"$out"; then
    got=pass
  else
    got=error
  fi
  states="$(grep -o "[0-9,]* distinct states found" <<<"$out" | tail -1)"
  # _POSSIBLE witness counts, e.g. [AckAfterTakeover |-> 12, ...]
  witnessed="$(grep -o '^\[[A-Za-z]* |->.*\]$' <<<"$out" | tail -1)"
  if [ "$got" = "$expect" ] || { [ "$expect" = violated ] && [ "$got" != pass ] && [ "$got" != error ]; }; then
    printf 'ok    %-24s %-18s %s %s\n' "$cfg" "$got" "$states" "$witnessed"
  else
    printf 'FAIL  %-24s got %s, expected %s\n' "$cfg" "$got" "$expect"
    status=1
  fi
done <<'LIST'
Sole pass
SoleDelays pass
NegNoConfirm AckedDurable
NegListBeforeTakeover AckedDurable
NegRewriteOrphan RestoreOK
NegOneOrphan SoleNeverFenced
NegContinueEpoch SoleNeverFenced
Takeover pass
AsyncSole pass
AsyncSoleDelays pass
NegNoDrain RestoreOK
NegLiveSnapshot RestoreOK
NegIgnoreIfMatch ManifestForward
NegAsyncContinueEpoch AsyncSoleNeverPoisoned
VacuityControl unwitnessed:LateLanding
NegRefuseLeftovers unwitnessed:BootstrapOverLeftover
NegDeleteLeftovers RestoreOK
NegNoChecksum RestoreOK
NegNoChecksumFence SoleNeverFenced
LiveSole pass
LiveAsyncSole pass
NegLiveStall EventuallyDurable
NegLiveRefuseLeftovers EventuallyRuns
LiveTakeover pass
LiveAsyncTakeover pass
NegLiveDuel EventuallyRuns
AsyncTakeover pass
ReadTakeover pass
NegReadNoRecheck ShownDurable
Destroy pass
AsyncDestroy pass
ReadDestroy pass
NegDestroyDeletes NewAfterDestroy
NegPurgeAll RestoreOK
NegTakeAnyGeneration NewAfterDestroy
NegSeqFromZero RestoreOK
DestroyManifestLoss pass
NegTrustRefused RefusedMeansIntact
NegSeqFromManifest RestoreOK
NegGCAnyGeneration RestoreOK
NegAdoptUnchecked ReadsAfterDestroy
WarmSole pass
WarmAsync pass
WarmTakeover pass
WarmDestroy pass
WarmAheadGuarded pass
NegWarmAhead WarmEqualsFull
NegWarmStale WarmEqualsFull
NegWarmRecreate WarmEqualsFull
NegWarmTrustSidecar WarmEqualsFull
WarmOverlap pass
WarmOverlapAsync pass
WarmGenGuarded pass
NegWarmNoGen WarmEqualsFull
NegReadRecheckGeneration ShownDurable
NegReadRecheckSeal ShownDurable
NegNoTakeoverSeal ShownDurable
NegReadTransitional ShownDurable
KrSole pass KeyRotation
KrSoleRetain pass KeyRotation
KrSoleKeys pass KeyRotation
KrReuse pass KeyRotation
KrTakeover pass KeyRotation
NegKrNoIfMatchSwitch AckedDurable KeyRotation
NegKrKeyBeforeLease KeyConsistent KeyRotation
NegKrNoCoverageCheck PitrExact KeyRotation
NegKrReleaseCurrent KeyConsistent KeyRotation
NegKrTrimPinned SourceKept KeyRotation
NegKrNoRetiredCheck RetiredStaysRetired KeyRotation
NegKrReuseWithPins HistoryBound KeyRotation
NegKrNoAdopt OutcomeFinal KeyRotation
NegKrFailUnlanded OutcomeFinal KeyRotation
NegKrWriterClock PitrExact KeyRotation
NegKrWriterClockBehind PitrExact KeyRotation
LIST

exit $status
